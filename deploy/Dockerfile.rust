# The Rust collaboration server (crates/serverd): one binary on a slim Debian, running as a non-root user.
# Build from the repository root:
#   docker build -f deploy/Dockerfile.rust -t openswx-collab-server-rust .
# On a small machine, limit the compiler's parallel jobs: --build-arg CARGO_BUILD_JOBS=2
# The Compose files deploy/docker-compose.rust*.yml build and run it.

FROM rust:1.99-slim-trixie AS build
# (Read by cargo when given; unset: as many jobs as the machine has cores.)
ARG CARGO_BUILD_JOBS
WORKDIR /src
# rust-toolchain.toml is left out on purpose: it names the `stable` channel, which would make rustup
# download a toolchain here instead of using the image's.
COPY Cargo.toml Cargo.lock ./
COPY crates crates
RUN cargo build --release --locked -p oswx-serverd \
    && strip target/release/openswx-collab-server

FROM debian:trixie-slim
LABEL org.opencontainers.image.source=https://github.com/DukeOfCheese/openswx-collab
# CA certificates: the machine's trust store, which the S3 client uses and the mail client adds to its
# own roots (install a private authority's certificate here, or point SSL_CERT_FILE at it).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home collab \
    && mkdir -p /data \
    && chown collab /data
COPY --from=build /src/target/release/openswx-collab-server /usr/local/bin/openswx-collab-server
USER collab
ENV OSWX_COLLAB_DATABASE_URL=sqlite:///data/collab.db \
    OSWX_COLLAB_STORAGE_URL=/data/storage
VOLUME /data
EXPOSE 8787
# No curl in the image: bash asks /api/health itself.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8787 && printf 'GET /api/health HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200 '"]
# SIGTERM (docker stop) stops it in order within OSWX_COLLAB_SHUTDOWN_TIMEOUT (8 s; docker waits 10).
# One process only: an open document lives in this process's memory. `serve` upgrades the database
# before it listens (unless OSWX_COLLAB_AUTO_MIGRATE=false).
CMD ["openswx-collab-server", "serve", "--host", "0.0.0.0", "--port", "8787"]
