# Copy to deploy/.env and fill in. Never commit the copy.
# The published image to run (the Python server, docker-compose.yml): a version (0.1.0) or latest
OSWX_COLLAB_VERSION=latest
PUBLIC_URL=https://collab.example.org
# PostgreSQL (docker-compose.yml, or docker-compose.rust-postgres.yml)
POSTGRES_PASSWORD=change-me
OPEN_REGISTRATION=false
# The port on this machine the server is published on (127.0.0.1 only)
HOST_PORT=8787
# The Compose network's subnet; the Rust server believes X-Forwarded-For only from it (your TLS proxy's
# connections arrive from its gateway; the Python server ignores it). Change it if it overlaps a network this machine has.
NETWORK_SUBNET=172.30.87.0/24
# The Rust server (docker-compose.rust.yml) is built here: parallel compiler jobs for the build
CARGO_BUILD_JOBS=2
# The Rust server only: the token GET /metrics asks for; empty: no /metrics. Make it long and random:
#   echo "METRICS_TOKEN=$(openssl rand -hex 32)"
METRICS_TOKEN=

# Optional: email (invites by email, password reset links). Leave SMTP_HOST empty for none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: sign-in with Google / GitHub (see docs/self-hosting.md for the callback addresses)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only with docker-compose.s3.yml (Garage). Make the three values with:
#   echo "S3_ACCESS_KEY=GK$(openssl rand -hex 16)"
#   echo "S3_SECRET_KEY=$(openssl rand -hex 32)"
#   echo "GARAGE_RPC_SECRET=$(openssl rand -hex 32)"
S3_BUCKET=openswx-collab
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
